# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=sqlite:///./magazine.db

# Claude API (classification) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Guardian Open Platform API — https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# X API OAuth 2.0 app credentials — https://developer.x.com/
# CLIENT_SECRET is only needed if your app is registered as "confidential"
# rather than "public" (PKCE-only) — leave blank for a public client.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Populate USER_ID/ACCESS_TOKEN/REFRESH_TOKEN by running
# scripts/x_oauth_setup.py once you have X API credits set up.
X_USER_ID=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# Basic auth in front of the web UI / OPDS catalog
OPDS_BASIC_AUTH_USER=
OPDS_BASIC_AUTH_PASSWORD=
